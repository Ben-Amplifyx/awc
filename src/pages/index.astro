---
import { Container, FeatureCard } from '@components/odyssey-theme';

import Layout from '../layouts/Page.astro';
import HomeHeroSection from '../components/sections/heros/HomeHeroSection.astro';
---

<Layout>
	<HomeHeroSection />
	<Container>
		<section class="feature-card__section">
			<h2>Learn About Cats</h2>
			<p>
				Explore our comprehensive guides covering everything from cat breeds to health care.
			</p>
			<div class="feature-card__grid">
				<FeatureCard href="/cats/behavior" title="Cat Behavior" imgSrc="/assets/images/owner-petting-a-hissing-angry-tabby-cat_AnnaKraynova_shutterstock.jpeg">
					Understand your cat's body language, vocalizations, and behaviors.
				</FeatureCard>
				<FeatureCard href="/cats/health" title="Cat Health" imgSrc="/assets/images/cats/home.jpeg">
					Keep your cat healthy with our comprehensive health and wellness guides.
				</FeatureCard>
				<FeatureCard href="/cats/gallery" title="Cat Gallery" imgSrc="/assets/images/persian.jpeg">
					Browse our beautiful collection of cat photos from different breeds.
				</FeatureCard>
				<FeatureCard href="/cats/fun-facts" title="Fun Cat Facts" imgSrc="/assets/images/blackcat.jpeg">
					Discover fascinating and entertaining facts about our feline friends.
				</FeatureCard>
			</div>
		</section>
	</Container>

	<Container>
		<section class="feature-card__section">
			<h2>Cat Breeds & Care Guides</h2>
			<p>
				Detailed information about different cat breeds and expert care advice.
			</p>
			<div class="feature-card__grid">
				<FeatureCard href="/blog/posts/persian-cat-breed-guide" title="Persian Cats" imgSrc="/assets/images/persian.jpeg">
					Learn about the gentle and luxurious Persian cat breed.
				</FeatureCard>
				<FeatureCard href="/blog/posts/maine-coon-breed-guide" title="Maine Coon Cats" imgSrc="/assets/images/maine-coon.jpeg">
					Discover the gentle giant of the cat world.
				</FeatureCard>
				<FeatureCard href="/blog/posts/siamese-cat-breed-guide" title="Siamese Cats" imgSrc="/assets/images/siamese.jpeg">
					Meet the vocal and affectionate Siamese breed.
				</FeatureCard>
				<FeatureCard href="/blog" title="All Breed Guides" imgSrc="/assets/images/breeds.jpeg">
					Explore our complete collection of cat breed guides and care tips.
				</FeatureCard>
			</div>
		</section>
	</Container>

	<Container>
		<section class="feature-card__section">
			<h2>Essential Cat Care</h2>
			<p>Everything you need to know to keep your cat happy and healthy.</p>
			<div class="feature-card__grid">
				<FeatureCard
					href="/blog/posts/cat-grooming-essentials"
					imgSrc="/assets/images/gromeing.jpeg"
					title="Grooming Guide"
				>
					Master the essential grooming techniques for your cat.
				</FeatureCard>
				<FeatureCard
					href="/blog/posts/feeding-your-cat-nutrition-guide"
					imgSrc="/assets/images/eating.jpeg"
					title="Nutrition Guide"
				>
					Learn about proper feeding and nutritional requirements.
				</FeatureCard>
				<FeatureCard
					href="/blog/posts/litter-box-training-and-maintenance"
					imgSrc="/assets/images/litter-box.jpeg"
					title="Litter Box Training"
				>
					Everything about litter box setup, training, and maintenance.
				</FeatureCard>
			</div>
		</section>
	</Container>
</Layout>

<style>
	.feature-card__section {
		margin: var(--section-margin) auto;
	}
	.feature-card__grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--theme-grid-gap);
	}
	@media (max-width: 768px) {
		.feature-card__grid {
			grid-template-columns: 1fr;
		}
	}
</style>

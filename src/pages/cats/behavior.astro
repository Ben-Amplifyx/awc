    <section class="enrichment">
      <h2>Environmental Enrichment</h2>
      <p>[Add tips for keeping cats mentally and physically stimulated]</p>
      <ul>
        <li>[Add enrichment idea 1]</li>
        <li>[Add enrichment idea 2]</li>
        <li>[Add enrichment idea 3]</li>
        <li>[Add enrichment idea 4]</li>
        <li>[Add enrichment idea 5]</li>
      </ul>
    </section>

    <section class="when-to-worry">
      <h2>When to Consult a Behaviorist</h2>
      <p>[Add signs that professional help is needed]</p>
    </section>
  </Container>
</Layout>

<style>
  .hero-section {
    text-align: center;
    margin: 3rem 0;
  }

  .lead {
    font-size: 1.25rem;
    color: var(--theme-text-secondary);
    max-width: 800px;
    margin: 1rem auto;
  }

  .behavior-guide {
    margin: 3rem 0;
  }

  .behavior-card {
    margin: 2rem 0;
    padding: 2rem;
    background: var(--theme-surface-1);
    border-radius: 8px;
  }

  .behavior-list {
    display: grid;
    gap: 1.5rem;
    margin-top: 1rem;
  }

  .behavior-item {
    padding: 1rem;
    background: var(--theme-surface-2);
    border-radius: 4px;
  }

  .behavior-item strong {
    display: block;
    color: var(--theme-primary);
    margin-bottom: 0.5rem;
  }

  .vocalizations {
    margin: 3rem 0;
  }

  .vocal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .vocal-card {
    padding: 1.5rem;
    background: var(--theme-surface-1);
    border-radius: 8px;
    border-top: 3px solid var(--theme-primary);
  }

  .common-behaviors {
    margin: 3rem 0;
  }

  .behavior-explanation {
    margin: 2rem 0;
    padding: 1.5rem;
    background: var(--theme-surface-1);
    border-radius: 8px;
    border-left: 4px solid var(--theme-primary);
  }

  .behavior-explanation h3 {
    margin-bottom: 1rem;
  }

  .behavior-explanation p {
    margin: 0.5rem 0;
  }

  .problem-behaviors {
    margin: 3rem 0;
  }

  .problem-card {
    margin: 1.5rem 0;
    padding: 1.5rem;
    background: var(--theme-surface-2);
    border-radius: 8px;
  }

  .problem-card h3 {
    margin-bottom: 1rem;
  }

  .enrichment {
    margin: 3rem 0;
    padding: 2rem;
    background: var(--theme-primary-light);
    border-radius: 8px;
  }

  .enrichment ul {
    margin-top: 1rem;
    padding-left: 2rem;
  }

  .enrichment li {
    margin: 0.5rem 0;
  }

  .when-to-worry {
    margin: 3rem 0;
    padding: 2rem;
    background: var(--theme-surface-1);
    border-radius: 8px;
    border: 2px solid var(--theme-warning, #ff9800);
  }
</style>

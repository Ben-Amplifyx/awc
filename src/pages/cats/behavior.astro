---
import { Container } from '@components/odyssey-theme';
import Layout from '../../layouts/Page.astro';

const seo = {
  title: 'Cat Behavior Guide | All About Cat\'s',
  description: 'Understanding cat behavior, body language, and communication to build a stronger bond with your feline friend.',
};
---

<Layout {seo}>
  <Container>
    <section class="hero-section">
      <h1>Understanding Cat Behavior 🐈</h1>
      <p class="lead">
        Learn to decode your cat's behavior, body language, and vocalizations to build a stronger, more loving relationship.
      </p>
    </section>

    <section class="behavior-guide">
      <h2>Reading Cat Body Language</h2>

      <div class="behavior-card">
        <h3>👁️ Eyes</h3>
        <div class="behavior-list">
          <div class="behavior-item">
            <strong>Slow Blinks:</strong>
            <p>[Add meaning and explanation]</p>
          </div>
          <div class="behavior-item">
            <strong>Dilated Pupils:</strong>
            <p>[Add meaning and explanation]</p>
          </div>
          <div class="behavior-item">
            <strong>Direct Stare:</strong>
            <p>[Add meaning and explanation]</p>
          </div>
          <div class="behavior-item">
            <strong>Avoiding Eye Contact:</strong>
            <p>[Add meaning and explanation]</p>
          </div>
        </div>
      </div>

      <div class="behavior-card">
        <h3>🦻 Ears</h3>
        <div class="behavior-list">
          <div class="behavior-item">
            <strong>Forward Facing:</strong>
            <p>[Add meaning and explanation]</p>
          </div>
          <div class="behavior-item">
            <strong>Flattened Back:</strong>
            <p>[Add meaning and explanation]</p>
          </div>
          <div class="behavior-item">
            <strong>Swiveling:</strong>
            <p>[Add meaning and explanation]</p>
          </div>
          <div class="behavior-item">
            <strong>One Ear Back:</strong>
            <p>[Add meaning and explanation]</p>
          </div>
        </div>
      </div>

      <div class="behavior-card">
        <h3>🐾 Tail Positions</h3>
        <div class="behavior-list">
          <div class="behavior-item">
            <strong>Upright with Curve:</strong>
            <p>[Add meaning and explanation]</p>
          </div>
          <div class="behavior-item">
            <strong>Puffed Up:</strong>
            <p>[Add meaning and explanation]</p>
          </div>
          <div class="behavior-item">
            <strong>Tucked Under:</strong>
            <p>[Add meaning and explanation]</p>
          </div>
          <div class="behavior-item">
            <strong>Swishing:</strong>
            <p>[Add meaning and explanation]</p>
          </div>
          <div class="behavior-item">
            <strong>Wrapped Around You:</strong>
            <p>[Add meaning and explanation]</p>
          </div>
        </div>
      </div>

      <div class="behavior-card">
        <h3>😺 Facial Expressions</h3>
        <div class="behavior-list">
          <div class="behavior-item">
            <strong>Relaxed Face:</strong>
            <p>[Add meaning and explanation]</p>
          </div>
          <div class="behavior-item">
            <strong>Whiskers Forward:</strong>
            <p>[Add meaning and explanation]</p>
          </div>
          <div class="behavior-item">
            <strong>Whiskers Back:</strong>
            <p>[Add meaning and explanation]</p>
          </div>
          <div class="behavior-item">
            <strong>Mouth Open (Flehmen Response):</strong>
            <p>[Add meaning and explanation]</p>
          </div>
        </div>
      </div>
    </section>

    <section class="vocalizations">
      <h2>Cat Vocalizations</h2>

      <div class="vocal-grid">
        <div class="vocal-card">
          <h3>Meowing</h3>
          <p>[Add explanation of different meow types and meanings]</p>
        </div>

        <div class="vocal-card">
          <h3>Purring</h3>
          <p>[Add explanation of purring and its various meanings]</p>
        </div>

        <div class="vocal-card">
          <h3>Hissing</h3>
          <p>[Add explanation of hissing and when cats do it]</p>
        </div>

        <div class="vocal-card">
          <h3>Chirping/Chattering</h3>
          <p>[Add explanation of chirping behavior]</p>
        </div>

        <div class="vocal-card">
          <h3>Growling</h3>
          <p>[Add explanation of growling]</p>
        </div>

        <div class="vocal-card">
          <h3>Trilling</h3>
          <p>[Add explanation of trilling]</p>
        </div>
      </div>
    </section>

    <section class="common-behaviors">
      <h2>Common Cat Behaviors Explained</h2>

      <div class="behavior-explanation">
        <h3>🐾 Kneading (Making Biscuits)</h3>
        <p><strong>What it looks like:</strong> [Add description]</p>

---
import { TextSection } from '@components/odyssey-theme';
import Layout from '../../layouts/Page.astro';
import HeroSection from '../../components/sections/heros/HeroSection.astro';

const seo = {
	title: 'About | All About Cat\'s',
	description: 'Learn about our mission to help cat lovers everywhere understand and care for their feline friends.',
};
---

<Layout {seo}>
	<HeroSection>
		<div slot="text-container">
			<h1>About All About Cat's</h1>
			<p>
				Welcome to All About Cat's - your comprehensive resource for everything related to our feline friends.
				We're passionate about helping cat lovers understand, care for, and appreciate their cats through
				expert information and guidance.
			</p>
		</div>
    <picture slot="image-container">
      <img
        src="/assets/images/home/classic-hero.jpg"
        alt="All About Cats"
        id="home-hero-image"
      />
    </picture>
	</HeroSection>
  <TextSection narrow>
    <h2>Our Mission</h2>
    <p>
      At All About Cat's, we believe that every cat deserves the best care possible. Our mission is to provide
      cat owners, enthusiasts, and future cat parents with accurate, accessible, and comprehensive information
      about all aspects of cat care, behavior, and health.
    </p>

    <h2>What We Offer</h2>
    <p>
      We cover everything from detailed breed guides and behavior insights to health care tips and fun facts.
      Whether you're a first-time cat owner or a seasoned cat parent, you'll find valuable information to help
      you build a stronger, more loving relationship with your feline companion.
    </p>

    <h2>Expert Resources</h2>
    <p>
      Our comprehensive guides are designed to be both informative and easy to understand. We cover:
    </p>
    <ul>
      <li><strong>Cat Breeds:</strong> Detailed profiles of popular and rare cat breeds</li>
      <li><strong>Behavior & Training:</strong> Understanding cat communication and body language</li>
      <li><strong>Health & Wellness:</strong> Preventive care, common health issues, and when to see a vet</li>
      <li><strong>Care Guides:</strong> Nutrition, grooming, and daily care routines</li>
      <li><strong>Fun & Education:</strong> Fascinating facts and trivia about cats</li>
    </ul>

    <h2>Join Our Community</h2>
    <p>
      Whether you're here to learn about a specific breed, solve a behavior challenge, or simply appreciate
      beautiful cat photos, we're glad you're here. Explore our resources, and feel free to reach out with
      any questions or feedback.
    </p>

    <p>
      <em>Made with love for cat lovers everywhere.</em>
    </p>
  </TextSection>
</Layout>
